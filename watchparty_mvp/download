:root{
  color-scheme:dark;
  --bg:#0b0b10;
  --panel:#15151d;
  --muted:#9292a3;
  --text:#f7f7fb;
  --line:#2a2a36;
  --accent:#7c5cff;
  --accent2:#9b86ff;
  --ok:#47d16c;
  --danger:#ff5d7a;
}
*{box-sizing:border-box}
html,body{min-height:100%}
body{
  margin:0;
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:
    radial-gradient(circle at 20% 0%,rgba(124,92,255,.16),transparent 34rem),
    radial-gradient(circle at 90% 18%,rgba(255,70,155,.06),transparent 28rem),
    var(--bg);
  color:var(--text);
}
button,input{font:inherit}
button{
  border:1px solid var(--line);
  background:#20202a;
  color:var(--text);
  border-radius:12px;
  padding:11px 15px;
  cursor:pointer;
  transition:.15s ease;
}
button:hover{filter:brightness(1.1);transform:translateY(-1px)}
button:active{transform:translateY(0)}
button.primary{
  background:linear-gradient(135deg,var(--accent),#8b55ff);
  border-color:transparent;
  font-weight:800;
}
button.danger{background:rgba(255,93,122,.14);border-color:rgba(255,93,122,.35)}
input{
  width:100%;
  border:1px solid var(--line);
  background:#0f0f15;
  color:var(--text);
  border-radius:12px;
  padding:12px 14px;
  outline:none;
}
input:focus{border-color:var(--accent)}
.app{max-width:1380px;margin:0 auto;padding:28px 18px 48px}
.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:22px;
}
.brand{font-weight:950;font-size:24px}
.version{
  font-size:10px;
  font-weight:800;
  letter-spacing:.08em;
  color:#c9bdff;
  background:rgba(124,92,255,.14);
  border:1px solid rgba(124,92,255,.35);
  padding:3px 6px;
  border-radius:99px;
  vertical-align:middle;
}
.tag{color:var(--muted);font-size:13px;margin-top:3px}
.presence{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px}
#dot{width:9px;height:9px;border-radius:50%;background:#555}
#dot.online{background:var(--ok);box-shadow:0 0 14px rgba(71,209,108,.6)}
.card{
  background:rgba(21,21,29,.94);
  border:1px solid var(--line);
  border-radius:18px;
  box-shadow:0 14px 48px rgba(0,0,0,.14);
}
.lobby{max-width:520px;margin:70px auto 0;padding:30px}
.lobby h1{margin:0 0 8px}
.lobby p{color:var(--muted);margin:0 0 24px}
label{display:grid;gap:8px;color:#d7d7e0;font-size:13px}
.row{display:flex;gap:10px;margin-top:16px}
.hidden{display:none!important}
.room{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:18px}
.main{display:grid;gap:14px}
.share{
  padding:14px 16px;
  display:grid;
  grid-template-columns:auto 1fr auto;
  align-items:center;
  gap:16px;
}
.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:10px;color:var(--muted)}
.participants{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}
.person{
  display:flex;
  align-items:center;
  gap:7px;
  border:1px solid var(--line);
  background:#101017;
  border-radius:999px;
  padding:7px 10px;
  font-size:12px;
}
.personDot{width:7px;height:7px;border-radius:50%;background:var(--ok)}
.personVoice{opacity:.55}
.personVoice.on{opacity:1}
.episodeBar{
  padding:14px;
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:12px;
}
.episodeInputs{
  flex:1;
  display:grid;
  grid-template-columns:95px 95px 1fr;
  gap:10px;
}
.source{padding:14px}
.tabs{display:flex;gap:8px;margin-bottom:12px}
.tab.active{background:#2b2940;border-color:#4e467a}
.sourceRow{display:grid;grid-template-columns:1fr auto;gap:10px}
.localHelp{color:var(--muted);font-size:13px;margin-bottom:10px}
.playerWrap{
  overflow:hidden;
  position:relative;
  aspect-ratio:16/9;
  background:#050507;
  display:flex;
  align-items:center;
  justify-content:center;
}
#youtubePlayer,.playerWrap iframe,.playerWrap video{
  width:100%;
  height:100%;
  border:0;
}
.emptyState{
  color:var(--muted);
  padding:30px;
  text-align:center;
  display:grid;
  gap:10px;
}
.emptyIcon{font-size:42px}
.overlayBtn{
  position:absolute;
  z-index:15;
  backdrop-filter:blur(8px);
  background:rgba(12,12,18,.72);
}
.fullscreenBtn{right:12px;top:12px;font-size:20px;padding:7px 11px}
.reactionLayer{
  position:absolute;
  inset:0;
  pointer-events:none;
  overflow:hidden;
  z-index:20;
}
.floatingReaction{
  position:absolute;
  bottom:8%;
  left:50%;
  font-size:42px;
  animation:floatReaction 1.9s ease-out forwards;
  filter:drop-shadow(0 7px 14px rgba(0,0,0,.45));
}
@keyframes floatReaction{
  0%{transform:translate(-50%,20px) scale(.7);opacity:0}
  15%{opacity:1}
  100%{transform:translate(calc(-50% + var(--drift)), -290px) scale(1.35) rotate(var(--rot));opacity:0}
}
.controls{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px 14px;
  gap:12px;
}
.controlGroup{display:flex;align-items:center;gap:12px}
#syncState{font-size:13px;color:var(--muted)}
.reactions{display:flex;gap:6px}
.reactionBtn{padding:8px 10px;font-size:18px}
.voiceCard{
  padding:14px 16px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
}
.voiceActions{display:flex;gap:8px}
.muted{color:var(--muted);font-size:12px;margin-top:4px}
.chat{min-height:560px;display:flex;flex-direction:column;overflow:hidden}
.chatHead{
  padding:16px;
  font-weight:800;
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.episodeBadge{
  font-size:11px;
  color:#cfc6ff;
  border:1px solid #423c69;
  background:#242038;
  border-radius:999px;
  padding:5px 8px;
}
.messages{flex:1;padding:14px;overflow:auto;display:flex;flex-direction:column;gap:10px}
.msg{background:#1f1f29;border-radius:12px;padding:9px 11px;word-break:break-word}
.msg .meta{font-size:11px;color:var(--muted);margin-bottom:4px}
.msg.system{background:transparent;color:var(--muted);font-size:12px;text-align:center}
.chatForm{display:grid;grid-template-columns:1fr auto;gap:8px;padding:12px;border-top:1px solid var(--line)}
@media(max-width:980px){
  .room{grid-template-columns:1fr}
  .chat{min-height:360px}
}
@media(max-width:700px){
  .app{padding:18px 10px 32px}
  .share{grid-template-columns:1fr auto}
  .participants{grid-column:1/-1;grid-row:2;justify-content:flex-start}
  .episodeBar{align-items:stretch;flex-direction:column}
  .episodeInputs{grid-template-columns:1fr 1fr}
  .titleInput{grid-column:1/-1}
  .episodeBar button{width:100%}
  .controls{align-items:stretch;flex-direction:column}
  .controlGroup{justify-content:space-between}
  .reactions{justify-content:space-between}
  .reactionBtn{flex:1}
  .voiceCard{align-items:stretch;flex-direction:column}
  .voiceActions button{flex:1}
}
